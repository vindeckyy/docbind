pipeline {
  agent { docker { image 'node:22-alpine' } }
  stages {
    stage('docbind') {
      steps {
        sh 'npx --yes github:vindeckyy/docbind check --sarif docbind.sarif'
      }
      post {
        always {
          archiveArtifacts artifacts: 'docbind.sarif', allowEmptyArchive: true
        }
      }
    }
  }
}
