{
  "name": "@vindeckyy/docbind",
  "version": "0.1.89",
  "description": "Static analysis for stale symbol references in markdown and reStructuredText. Supports TypeScript, JavaScript, Python, Rust, and Go.",
  "type": "module",
  "bin": {
    "docbind": "./dist/main.js"
  },
  "files": [
    "dist",
    "python",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/main.ts --format esm --clean --sourcemap --external typescript",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "gate:changed": "tsx scripts/changed-coverage.ts",
    "gate:struct": "tsx scripts/struct-gate.ts",
    "gate": "npm run coverage && npm run gate:changed -- --all && npm run gate:struct",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "corpus": "tsx scripts/corpus.ts",
    "prepare": "npm run build",
    "prepublishOnly": "npm run gate",
    "bench": "tsx scripts/bench.ts",
    "thresholds": "tsx scripts/threshold-sweep.ts",
    "corpus:fixtures": "tsx scripts/corpus.ts --local-only --strict --only macro-fixture,go-package-fixture,go-cycle-fixture,python-fields-fixture,rst-fixture,python-docstrings-fixture,python-asciidoc-fixture,java-javadoc-fixture"
  },
  "dependencies": {
    "ignore": "^7.0.14",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "picocolors": "^1.1.1",
    "tinyglobby": "^0.2.17",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^5.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "author": {
    "name": "Hayden",
    "url": "https://github.com/vindeckyy"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vindeckyy/docbind.git"
  },
  "homepage": "https://vindeckyy.github.io/docbind/",
  "bugs": {
    "url": "https://github.com/vindeckyy/docbind/issues"
  },
  "keywords": [
    "documentation",
    "static-analysis",
    "markdown",
    "typescript",
    "python",
    "rust",
    "go",
    "cli",
    "ci",
    "code-quality",
    "developer-tools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "private": false
}
